# Copy to .env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The address Caddy serves. On a public VPS use <public-ip>.sslip.io (and remove
# `tls internal` from the Caddyfile for a real Let's Encrypt cert). Locally, use
# localhost.
SITE_ADDRESS=localhost

# The image to run. Locally this is the image you built (tdm-capstone:local).
# In production, point it at your registry, e.g. ghcr.io/<you>/tdm-capstone:latest
APP_IMAGE=tdm-capstone:local
