# syntax=docker/dockerfile:1
# The right way to use a secret at build time: mount it, never COPY or ENV it.
FROM node:22-alpine
WORKDIR /app
COPY server.js ./
# The secret is available only during this RUN, at /run/secrets/api_token.
# It is never written into a layer, so it will not show up in `docker history`
# or in the final image.
RUN --mount=type=secret,id=api_token \
    test -s /run/secrets/api_token && echo "secret was available at build time"
USER node
EXPOSE 3000
CMD ["node", "server.js"]
